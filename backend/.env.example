# CivicSense Backend Configuration
# Copy this file to .env and fill in your values

# Flask Security (change these in production!)
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-to-another-long-random-string-in-production

# Database
# SQLite (default for development — no setup needed):
# DATABASE_URL=sqlite:///civicsense.db
# MySQL (production):
# DATABASE_URL=mysql+pymysql://username:password@localhost/civicsense_db

# OpenWeatherMap API (free at openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Email (Gmail example — use App Password, not your real password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=theramu457@gmail.com
MAIL_PASSWORD=qwww qmvu aujn eavz
MAIL_DEFAULT_SENDER=noreply@civicsense.in

# Twilio SMS (optional — for disaster SMS alerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# App URL (used in email links)
APP_URL=http://localhost:3000
